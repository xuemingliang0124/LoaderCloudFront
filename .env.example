# ===== 阿里云镜像仓库前缀（末尾不要加 /）=====
REGISTRY=registry.cn-beijing.aliyuncs.com/xml066

# ===== 前端镜像名 & 标签 =====
# 本地开发用 latest；Jenkins 构建时会覆盖为 git commit short hash
FRONTEND_IMAGE=loader-cloud-frontend
FRONTEND_TAG=latest

# ===== 后端服务地址（前端 nginx 反向代理目标）=====
# 服务器变更时只改这里，无需修改 docker-compose.yml
# 也可通过 Jenkins 构建参数 BACKEND_HOST/BACKEND_PORT 覆盖
BACKEND_HOST=192.168.1.100
BACKEND_PORT=8000
